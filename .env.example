# Copy to .env and fill in every empty value. Compose refuses to start while a
# required secret is empty. Generate random secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# JWT signing key: random, at least 32 bytes. The API refuses shorter keys.
JWT_SECRET_KEY=

# Database superuser/root accounts: used only by the database containers to
# initialize themselves. The API connects with the *_APP_* accounts below,
# which db/postgres and db/mongo create with least privilege.
POSTGRES_USER=databix
POSTGRES_PASSWORD=
POSTGRES_APP_USER=databix_app
POSTGRES_APP_PASSWORD=
POSTGRES_DB=databix_hot
POSTGRES_PORT_BINDING=127.0.0.1:5433:5432

MONGO_ROOT_USERNAME=databix
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=databix_app
MONGO_APP_PASSWORD=
MONGODB_DATABASE=databix_cold

REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# Service account for the MCP proxy. Create it with:
#   docker compose exec backend python -m auth.manage create-user <username>
MCP_BACKEND_USERNAME=
MCP_BACKEND_PASSWORD=

GRAFANA_ADMIN_PASSWORD=

# Self-service signup (POST /api/v1/auth/signup). Off by default; operators
# create accounts with `python -m auth.manage`.
AUTH_SIGNUP_ENABLED=false

# Interactive API docs at /docs and /openapi.json. Enable for local development only.
API_DOCS_ENABLED=false

# Comma-separated browser origins allowed to call the API. Empty means none,
# which suits a web UI served from the same origin through nginx.
CORS_ORIGINS=

# Host binding for plain-HTTP nginx. Keep it on loopback; use
# docker-compose.tls.yml for anything reachable from the network.
NGINX_HTTP_BINDING=127.0.0.1:80

# Optional: run the Docker socket proxy unprivileged as 65534:<host docker group id>
# (see `getent group docker`). Defaults to root with all capabilities dropped.
# DOCKER_SOCKET_PROXY_USER=65534:999
