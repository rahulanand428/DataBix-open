discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "fastapi_logs" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_collect_logs"]
		regex         = "true"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_service_name"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "container"
	}
}

loki.source.docker "scrape" {
  host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.fastapi_logs.output
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
