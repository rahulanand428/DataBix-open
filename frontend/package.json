{
  "name": "databix-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './apps/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' run typecheck",
    "test": "pnpm -r --filter './packages/*' run test",
    "dev": "pnpm -r --parallel --filter './apps/*' run dev",
    "generate:api": "pnpm --filter @databix/sdk run generate:api",
    "e2e": "pnpm --filter @databix/e2e test",
    "screenshots": "pnpm --filter @databix/e2e exec playwright test --project=screenshots"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
